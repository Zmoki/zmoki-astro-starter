---
// Analytics dispatcher. Renders every provider whose config is set; each one
// chains onto window.track/window.identify, so one call reaches all of them.
// Off unless PUBLIC_ANALYTICS_ENABLED="true". See AGENTS.md → Swappable providers.
import PostHog from "@/components/analytics/posthog.astro";
import Gtm from "@/components/analytics/gtm.astro";
import { posthogConfigured } from "@/components/analytics/posthog-config";
import { gtmConfigured } from "@/components/analytics/gtm-config";

const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED === "true";
---

{analyticsEnabled && gtmConfigured && <Gtm />}
{analyticsEnabled && posthogConfigured && <PostHog />}
