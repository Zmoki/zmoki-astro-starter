---
// Captcha dispatcher. At most one provider renders, because two widgets would
// inject competing hidden tokens. Brevo validates the token against the captcha
// set on the Brevo form, so keep the two in sync.
// Off unless PUBLIC_CAPTCHA_ENABLED="true". See AGENTS.md → Swappable providers.
import Turnstile from "@/components/captcha/turnstile.astro";
import { TURNSTILE_SITE_KEY } from "@/components/captcha/turnstile-config";

const captchaEnabled = import.meta.env.PUBLIC_CAPTCHA_ENABLED === "true";

// Priority order: the first provider with its site key set wins.
const providers = [{ enabled: !!TURNSTILE_SITE_KEY, Component: Turnstile }];

const Active = captchaEnabled ? providers.find((p) => p.enabled)?.Component : undefined;
---

{Active && <Active />}
