---
// Form dispatcher for the resource lead-magnet gate. Renders one provider from
// src/components/forms/. The backend also checks the captcha and emails the
// asset, so swapping providers means changing the backend too.
// See AGENTS.md → Swappable providers.
import Brevo from "@/components/forms/brevo.astro";

export interface Props {
  /** Provider form id (Brevo: the sibforms serve id). */
  formId: string;
  buttonText?: string;
  resourceSlug?: string;
}

const { formId, buttonText, resourceSlug } = Astro.props;

// A gate posts to one backend: the first entry wins.
const providers = [Brevo];
const Provider = providers[0];
---

<Provider formId={formId} buttonText={buttonText} resourceSlug={resourceSlug}>
  <slot />
</Provider>
