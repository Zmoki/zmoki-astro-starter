---
// Content image. Imported assets and URLs on site.platform.imagesCDNHost are
// optimized at build into AVIF with a WebP fallback. Any other URL renders a plain
// <img>, so there is no build-time fetch and no srcset that repeats the original
// at every width. Every image also emits ImageObject license JSON-LD, whose
// contentUrl is a rendition, never the origin. See the /images skill.
import { Picture } from "astro:assets";
import JsonLd from "@/components/JsonLd.astro";
import { imageObject } from "@/lib/structured-data";
import { isOnImageOrigin, publishedImageUrl, remoteImageSize } from "@/lib/images";
import { site } from "@/site.config";

type ImageLayout = "constrained" | "fullWidth" | "fixed";

interface Props {
  /** An imported asset or a full remote URL. An origin URL without a size is measured at build. */
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  layout?: ImageLayout;
  /** Eager load with fetchpriority=high. Set it on the LCP/hero image only. */
  priority?: boolean;
  sizes?: string;
  /** Credit a Person as the ImageObject creator. Defaults to the site organization. */
  author?: { name: string; url: string };
  /** ImageObject license URL. Defaults to site.copyright.images.license. */
  licenseUrl?: string;
  /** Emit the ImageObject license JSON-LD. Off for photos the site doesn't own, such as people's. */
  schema?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  layout = "constrained",
  priority = false,
  sizes,
  author,
  licenseUrl,
  schema = true,
  class: className,
  ...rest
} = Astro.props;

const willOptimize = typeof src !== "string" || isOnImageOrigin(src);
// Markdown `![]()` (mapped here in src/lib/content-components.ts) gives no size.
// A missing side is derived from the natural aspect ratio, so the image isn't cropped.
const natural =
  typeof src === "object"
    ? src
    : willOptimize && !(width && height)
      ? await remoteImageSize(src)
      : undefined;
const finalWidth =
  width ??
  (height && natural ? Math.round((natural.width * height) / natural.height) : natural?.width);
const finalHeight =
  height ??
  (natural && finalWidth ? Math.round((natural.height * finalWidth) / natural.width) : undefined);
const astroLayout: "constrained" | "fixed" | "full-width" =
  layout === "fullWidth" ? "full-width" : layout;

// <Picture> props are a union of a string src and an ImageMetadata src. Casting src
// to string picks one overload for the types. Astro checks typeof at runtime, so
// an imported asset still optimizes.
const shared = {
  src: src as string,
  alt,
  width: finalWidth as number,
  height: finalHeight as number,
  loading: (priority ? "eager" : "lazy") as "eager" | "lazy",
  ...(priority ? ({ fetchpriority: "high" } as const) : {}),
};

const hasCaption = Astro.slots.has("default");
const imageLd =
  schema &&
  imageObject({
    contentUrl: await publishedImageUrl(src),
    license: licenseUrl ?? site.copyright.images.license,
    author,
  });

// In a figure, <picture> is display: contents, so the <img> stays the centered flex item.
const captionImgClasses =
  "border-zmoki-stone-200 max-w-[min(600px,100%)] rounded-xl border shadow-sm";
---

{hasCaption ? (
  <figure class="!my-0 flex w-full flex-col items-center">
    {willOptimize ? (
      <Picture
        {...shared}
        layout={astroLayout}
        formats={["avif"]}
        fallbackFormat="webp"
        pictureAttributes={{ class: "contents" }}
        {...(sizes ? { sizes } : {})}
        class:list={[captionImgClasses, className]}
        {...rest}
      />
    ) : (
      <img {...shared} decoding="async" class:list={[captionImgClasses, className]} {...rest} />
    )}
    <figcaption class="text-zmoki-stone-500 !mt-0 max-w-[520px] text-center text-sm">
      <slot />
    </figcaption>
  </figure>
) : willOptimize ? (
  <Picture
    {...shared}
    layout={astroLayout}
    formats={["avif"]}
    fallbackFormat="webp"
    {...(sizes ? { sizes } : {})}
    class={className}
    {...rest}
  />
) : (
  <img {...shared} decoding="async" class={className} {...rest} />
)}
{imageLd && <JsonLd schema={imageLd} />}
