---
/**
 * Renders a schema.org JSON-LD block. Pass one schema, or an array to emit
 * several. JSON-LD is valid anywhere in the document, so it doesn't need to be
 * in <head>. See the /structured-data skill.
 */
export interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;

// set:html does not escape, so "<" is escaped to stop a "</script>" in any
// string value from closing the tag.
const json = JSON.stringify(schema).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} is:inline />
