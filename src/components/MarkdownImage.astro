---
// What Markdown `![]()` renders in .mdx (mapped in src/lib/content-components.ts).
// Local and origin images go through <Image>: optimized, with license JSON-LD.
// Any other URL stays a plain <img> with no license JSON-LD, since the site doesn't own it.
import Image from "@/components/Image.astro";
import { isOnImageOrigin } from "@/lib/images";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  [key: string]: unknown;
}

const { src, alt = "", ...rest } = Astro.props;
---

{typeof src !== "string" || isOnImageOrigin(src) ? (
  <Image src={src} alt={alt} {...rest} />
) : (
  <img src={src} alt={alt} loading="lazy" decoding="async" {...rest} />
)}
