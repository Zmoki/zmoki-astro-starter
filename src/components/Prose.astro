---
// Card panel for rendered Markdown/MDX. Pass `class` for the prose size and
// padding, which vary per page.
//
// rehypeCodeBlockCopy adds a Copy button to all rendered content, so the button
// wiring lives here rather than in one layout.
export interface Props {
  class?: string;
}

const { class: extra = "" } = Astro.props;

const base =
  "prose border-zmoki-stone-200 prose-headings:font-semibold max-w-none rounded-2xl border bg-white px-4 py-8 shadow-sm md:p-16";
---

<div class:list={[base, extra]}>
  <slot />
</div>

<script>
  // Bundled, so it runs once per page and binds the buttons in every panel.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-button="true"]').forEach((btn) => {
    btn.addEventListener("click", async () => {
      const wrapper = btn.closest(".relative");
      const codeBlock = wrapper?.querySelector("pre code");
      const code = codeBlock?.textContent ?? "";

      window.track?.("code_block_copied", { snippet_length: code.length });
      if (!code) return;

      const original = btn.textContent;
      const markCopied = () => {
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      };

      try {
        await navigator.clipboard.writeText(code);
        markCopied();
      } catch {
        // Fallback for browsers without the async clipboard API.
        const textArea = document.createElement("textarea");
        textArea.value = code;
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand("copy");
          markCopied();
        } catch (fallbackErr) {
          console.error("Failed to copy code:", fallbackErr);
        }
        document.body.removeChild(textArea);
      }
    });
  });
</script>
