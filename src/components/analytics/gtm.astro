---
// Google Tag Manager. A tracked event becomes dataLayer.push({ event, ...props });
// match `event` with a "Custom Event" trigger in GTM.
//
// The only provider that runs inline, because GTM wants to start in <head>. The
// snippet lives in src/lib/inline-scripts.ts, which the CSP hashes.
import { gtmLoader } from "@/lib/inline-scripts";
---

<script is:inline set:html={gtmLoader} />
