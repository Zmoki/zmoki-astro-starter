---
// Cloudflare Turnstile. api.js renders every `.cf-turnstile` element and adds a
// hidden token that Brevo validates on submit. Keep the `g-recaptcha` class:
// Brevo uses it to find the captcha field.
//
// The loader is an external script on a CSP-allowlisted host, so is:inline is
// allowed here.
import { TURNSTILE_SITE_KEY } from "@/components/captcha/turnstile-config";
---

<div
  class="cf-turnstile g-recaptcha"
  data-sitekey={TURNSTILE_SITE_KEY}
  data-size="flexible"
  data-language="en"
></div>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
