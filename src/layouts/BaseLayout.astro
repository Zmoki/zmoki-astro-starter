---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { fonts } from "@/design-tokens.mjs";
import Analytics from "@/components/Analytics.astro";
import Button from "@/components/Button.astro";
import { site } from "@/site.config";
import { getOgImage } from "@/og/manifest";
import { siteUrls } from "@/lib/urls";
import { isNoindex, robotsContent } from "@/lib/robots";
import { isPreviewBuild } from "@/lib/deploy";
import { commitHash } from "@/lib/version";

export interface Props {
  title: string;
  description?: string;
  publishDate?: Date;
  contentModifiedDate?: Date;
  /**
   * The page reads as an article (a post, news): og:type="article" plus the
   * article:*_time tags, which need both dates. Other pages stay "website".
   */
  article?: boolean;
  /**
   * Robots directives added to the site default, e.g. ["noindex"]. Directives
   * that imply noindex also drop the page from the sitemap.
   */
  robots?: string[];
  /**
   * Full-width <main> for landing sections that own their containers.
   * Default: a centered column.
   */
  wide?: boolean;
  /**
   * `true` (default): the page's own URL. `false`: no canonical tag, e.g. the
   * 404 page. A URL string: for content republished from another site.
   */
  canonical?: boolean | string;
}

const {
  title,
  description = site.description,
  publishDate,
  contentModifiedDate,
  article = false,
  robots,
  wide = false,
  canonical = true,
} = Astro.props;

const pagePathname = Astro.url.pathname;

// Preview deploys are public, and a canonical is only a hint, so they're noindex.
const pageRobots =
  isPreviewBuild(site.platform.deploy) && !isNoindex(robots)
    ? ["noindex", ...(robots ?? [])]
    : robots;

const isPageArticle = article && publishDate && contentModifiedDate;

// One helper for every absolute URL, so canonical, OG and JSON-LD match.
const urls = siteUrls(Astro);
const selfURL = urls.absoluteUrl(pagePathname);
const canonicalURL =
  canonical === false ? null : typeof canonical === "string" ? canonical : selfURL;

// Falls back to the site's default card. Image URLs use the current origin, so a
// preview deploy shows its own cards.
const ogImage = await getOgImage(pagePathname);
const pageImageUrl = urls.currentAbsoluteUrl(ogImage.path);

// Bare host (no protocol) for the footer copyright link, e.g. "zmoki.xyz".
const ownerSiteLabel = new URL(site.organization.url).host;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="version" content={commitHash} />
    <!-- Favicons: generated by `npm run favicons` -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/brand-mark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Preload only the upright sans (headings and body): a late swap re-wraps the hero
         copy and pushes the LCP image down. Italic and mono load on use. -->
    <Font cssVariable={fonts.sans.variable} preload={[{ style: "normal" }]} />
    <Font cssVariable={fonts.mono.variable} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent(pageRobots)} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed"
      href={urls.absoluteUrl("/rss.xml")}
    />

    <!-- Open Graph meta tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={selfURL} />
    <meta property="og:type" content={isPageArticle ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <!-- Landscape first, then square: consumers take the first image they support. -->
    {ogImage.images.map((image) => (
      <>
        <meta property="og:image" content={urls.currentAbsoluteUrl(image.path)} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={ogImage.alt} />
      </>
    ))}
    {isPageArticle && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {isPageArticle && (
      <meta property="article:modified_time" content={contentModifiedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImageUrl} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <!-- Page-specific extras, e.g. preloading the LCP image: <Fragment slot="head">. -->
    <slot name="head" />

    <Analytics />
  </head>
  <body
    data-asks={JSON.stringify(site.asks)}
    class="bg-zmoki-cream-100 text-zmoki-stone-900 flex min-h-full flex-col font-sans text-lg leading-normal tracking-tight xl:text-xl"
  >
    <header
      data-band="header"
      class="border-zmoki-stone-200 bg-zmoki-cream-100/80 sticky top-0 z-40 border-b backdrop-blur-md"
    >
      <nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 lg:px-8">
        <a href="/" class="flex items-center" aria-label={`${site.name} — home`}>
          <img
            src="/brand-mark.svg"
            alt={site.name}
            width="36"
            height="36"
            class="size-9 rounded-lg"
          />
        </a>
        <div class="flex items-center gap-4 md:gap-6">
          <ul class="hidden items-center gap-6 md:flex">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-zmoki-stone-600 hover:text-zmoki-stone-900 text-sm font-medium transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <Button href={site.asks.use_template}>Get started</Button>
        </div>
      </nav>
    </header>

    <main class:list={["w-full flex-1", !wide && "mx-auto max-w-4xl px-4 py-10 lg:py-16"]}>
      <slot />
    </main>

    <script>
      import "@/lib/site-events";
    </script>

    <footer data-band="footer" class="border-zmoki-stone-200 border-t bg-white">
      <div class="text-zmoki-stone-500 mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-8 text-sm md:flex-row md:items-center md:justify-between lg:px-8">
        <p>
          &copy; {site.copyright.year} · {site.organization.name} ·{" "}
          <a href={site.organization.url}>{ownerSiteLabel}</a>
        </p>
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="/legal/privacy/">Privacy</a>
          <a href="/legal/terms/">Terms</a>
          <a href={`mailto:${site.contact.email}`}>Contact</a>
          <a href={site.social.github}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
