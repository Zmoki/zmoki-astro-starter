---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import PostList from "@/components/PostList.astro";
import { getPostsNewestFirst } from "@/lib/page-collections";
import { blogPagePath, pageCount, pageItems, splitFeatured } from "@/lib/blog";

// Also read by the OG card, the sitemap and the RSS feed.
export const meta = {
  path: "blog/",
  ogKey: "blog",
  title: "Blog",
  description: "Posts and guides about building your site with the Zmoki Astro Starter.",
  lists: "blog/",
} satisfies StandalonePageMeta;

// Page 1: the featured post as the hero, then the first page of the rest.
// Later pages: src/pages/blog/page/[page].astro.
const { featured, rest } = splitFeatured(await getPostsNewestFirst());
const hrefs = Array.from({ length: pageCount(rest) }, (_, i) => blogPagePath(i + 1));
---

<BaseLayout title={meta.title} description={meta.description}>
  <header class="mb-10">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Blog</h1>
    <p class="text-zmoki-stone-600 mt-3 text-lg">{meta.description}</p>
  </header>

  {!featured && rest.length === 0 ? (
    <p>No posts yet. Check back soon!</p>
  ) : (
    <>
      {featured && (
        <div class="mb-6">
          <PostCard post={featured} featured />
        </div>
      )}
      <PostList posts={pageItems(rest, 1)} hrefs={hrefs} current={1} />
    </>
  )}
</BaseLayout>
