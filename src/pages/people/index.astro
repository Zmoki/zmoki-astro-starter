---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { homeCrumb } from "@/lib/crumbs";
import { getProfiles, personToProps } from "@/lib/people";

// Also read by the OG card and the sitemap.
export const meta = {
  path: "people/",
  ogKey: "people",
  title: "People",
  description: "The people who write and build the Zmoki Astro Starter.",
  publishDate: new Date("2026-10-27"),
  contentModifiedDate: new Date("2026-10-27"),
  lists: "people/",
} satisfies StandalonePageMeta;

const people = (await getProfiles()).map(personToProps);
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="mb-6">
    <Breadcrumbs crumbs={[homeCrumb, { name: meta.title }]} />
  </div>
  <header class="mb-10">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{meta.title}</h1>
    <p class="text-zmoki-stone-600 mt-3 text-lg">{meta.description}</p>
  </header>

  {people.length === 0 ? (
    <p>No profiles yet.</p>
  ) : (
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {people.map((person) => (
        <li class="border-zmoki-stone-200 overflow-hidden rounded-2xl border bg-white shadow-sm transition-shadow hover:shadow-md">
          <a href={person.profilePath} class="flex h-full flex-col gap-2 p-6 md:p-8">
            <h2 class="text-zmoki-stone-900 text-2xl font-semibold">{person.name}</h2>
            <p class="text-zmoki-stone-600">
              {person.role}
              {person.company && `, ${person.company}`}
            </p>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
